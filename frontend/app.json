{
  "expo": {
    "name": "Agent Mart Admin",
    "slug": "agentmart-platform-admin",
    "version": "1.0.0",
    "scheme": "agentmartadmin",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f4f5f7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agentmart.platformadmin",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.agentmart.platformadmin",
      "adaptiveIcon": {
        "backgroundColor": "#1f5fbf",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Agent Mart Platform Admin",
      "shortName": "Agent Mart Admin",
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "themeColor": "#11161f",
      "backgroundColor": "#f4f5f7"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-font"
    ]
  }
}
