# ---------- Server ----------
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (Expo web / dev tools). Native apps send no Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# When true, requests not arriving over HTTPS (x-forwarded-proto) are rejected. Enable in production behind a TLS proxy.
REQUIRE_HTTPS=false
SWAGGER_ENABLED=true

# ---------- Database ----------
DATABASE_URL=postgresql://agentmart:agentmart_dev_password@localhost:5432/agentmart_admin?schema=public

# ---------- Auth / sessions ----------
SESSION_TTL_MINUTES=120
ELEVATION_TTL_MINUTES=10

# ---------- Imports ----------
# Plot code format. CONFIRM the exact regex against assets/app.js in the APK source archive.
PLOT_CODE_REGEX=^[A-Z0-9]{2,10}(-[A-Z0-9]{1,12}){1,4}$

# ---------- Provider status flags (shown on Settings screen; they do NOT establish connectivity) ----------
AI_PROVIDER=
STORAGE_PROVIDER=
EMAIL_PROVIDER=
SMS_PROVIDER=
PUSH_PROVIDER=
PAYMENT_PROVIDER=
TITLE_PROVIDER=

# ---------- Seeding ----------
SEED_DEMO_DATA=false
